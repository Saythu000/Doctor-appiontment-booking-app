<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer rules.
  This app stores patient health data and session credentials locally, so
  nothing may leave the device through cloud backup or device-to-device
  transfer. (Keystore-encrypted secure storage also cannot be restored on
  another device, so backing it up would only produce broken data.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
